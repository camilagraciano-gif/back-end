import express from 'express' 

const app = express()
const porta = 3000

app. get('/', (req, res ) => {
    res.send ('Olá, abacaxi!')
})
app. get('/', (req, res ) => {
    res.send (
        `<h>Olá, Morango do amor</h>
        <p> Nossa loja de morangos...</p>
        `)
    })


app. listen (porta, ()=> {console.log ('servidor está vivo ')})